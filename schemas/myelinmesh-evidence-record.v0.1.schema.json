{
  "$defs": {
    "ArtifactReference": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "media_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Media Type"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-fA-F0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "size_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Size Bytes"
        },
        "uri": {
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "uri"
      ],
      "title": "ArtifactReference",
      "type": "object"
    },
    "ChangeEvidence": {
      "additionalProperties": false,
      "properties": {
        "after_hash": {
          "anyOf": [
            {
              "pattern": "^[a-fA-F0-9]{6,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "After Hash"
        },
        "artifact": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Artifact",
          "type": "string"
        },
        "before_hash": {
          "anyOf": [
            {
              "pattern": "^[a-fA-F0-9]{6,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Before Hash"
        },
        "change_type": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Change Type",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "summary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Summary"
        }
      },
      "required": [
        "change_type",
        "artifact"
      ],
      "title": "ChangeEvidence",
      "type": "object"
    },
    "Context": {
      "additionalProperties": false,
      "properties": {
        "domain": {
          "$ref": "#/$defs/Domain",
          "default": "unknown"
        },
        "environment": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Environment"
        },
        "subject": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subject"
        },
        "system": {
          "maxLength": 300,
          "minLength": 1,
          "title": "System",
          "type": "string"
        },
        "task": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task"
        }
      },
      "required": [
        "system"
      ],
      "title": "Context",
      "type": "object"
    },
    "DiagnosisEvidence": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "hypotheses": {
          "items": {
            "type": "string"
          },
          "title": "Hypotheses",
          "type": "array"
        },
        "method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Method"
        },
        "supported_facts": {
          "items": {
            "type": "string"
          },
          "title": "Supported Facts",
          "type": "array"
        },
        "unsupported_hypotheses": {
          "items": {
            "type": "string"
          },
          "title": "Unsupported Hypotheses",
          "type": "array"
        }
      },
      "title": "DiagnosisEvidence",
      "type": "object"
    },
    "Domain": {
      "enum": [
        "agent",
        "physical_ai",
        "ml_system",
        "hybrid",
        "unknown"
      ],
      "title": "Domain",
      "type": "string"
    },
    "ExecutionEvidence": {
      "additionalProperties": false,
      "properties": {
        "artifacts": {
          "items": {
            "$ref": "#/$defs/ArtifactReference"
          },
          "title": "Artifacts",
          "type": "array"
        },
        "ended_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ended At"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Id"
        },
        "scenario": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scenario"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        },
        "started_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started At"
        },
        "tools": {
          "items": {
            "type": "string"
          },
          "title": "Tools",
          "type": "array"
        }
      },
      "title": "ExecutionEvidence",
      "type": "object"
    },
    "FailureEvidence": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "detected": {
          "title": "Detected",
          "type": "boolean"
        },
        "failure_class": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failure Class"
        },
        "severity": {
          "$ref": "#/$defs/Severity",
          "default": "unknown"
        },
        "supported_by": {
          "items": {
            "type": "string"
          },
          "title": "Supported By",
          "type": "array"
        }
      },
      "required": [
        "detected"
      ],
      "title": "FailureEvidence",
      "type": "object"
    },
    "Identity": {
      "additionalProperties": false,
      "properties": {
        "captured_at": {
          "format": "date-time",
          "title": "Captured At",
          "type": "string"
        },
        "evidence_id": {
          "maxLength": 200,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Evidence Id",
          "type": "string"
        },
        "project": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Project",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "project",
        "captured_at"
      ],
      "title": "Identity",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "commit_sha": {
          "anyOf": [
            {
              "pattern": "^[a-fA-F0-9]{6,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Commit Sha"
        },
        "dataset_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dataset Name"
        },
        "dataset_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dataset Version"
        },
        "environment": {
          "additionalProperties": true,
          "title": "Environment",
          "type": "object"
        },
        "producer": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Producer",
          "type": "string"
        },
        "producer_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Producer Version"
        },
        "repository_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Repository Url"
        },
        "source_type": {
          "$ref": "#/$defs/SourceType"
        }
      },
      "required": [
        "source_type",
        "producer"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "RecoveryEvidence": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "title": "Action",
          "type": "string"
        },
        "applicable_conditions": {
          "additionalProperties": true,
          "title": "Applicable Conditions",
          "type": "object"
        },
        "negative_evidence": {
          "items": {
            "type": "string"
          },
          "title": "Negative Evidence",
          "type": "array"
        },
        "outcome": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Outcome"
        },
        "successful": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Successful"
        }
      },
      "required": [
        "action"
      ],
      "title": "RecoveryEvidence",
      "type": "object"
    },
    "Severity": {
      "enum": [
        "info",
        "warning",
        "breaking",
        "critical",
        "unknown"
      ],
      "title": "Severity",
      "type": "string"
    },
    "SourceType": {
      "enum": [
        "real",
        "simulation",
        "benchmark",
        "synthetic",
        "human_review",
        "imported"
      ],
      "title": "SourceType",
      "type": "string"
    },
    "ValidationEvidence": {
      "additionalProperties": false,
      "properties": {
        "human_reviewed": {
          "default": false,
          "title": "Human Reviewed",
          "type": "boolean"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "real_or_synthetic": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceType"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "replay_count": {
          "default": 0,
          "minimum": 0,
          "title": "Replay Count",
          "type": "integer"
        },
        "reproduced_count": {
          "default": 0,
          "minimum": 0,
          "title": "Reproduced Count",
          "type": "integer"
        },
        "reviewer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewer"
        }
      },
      "title": "ValidationEvidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "change": {
      "anyOf": [
        {
          "$ref": "#/$defs/ChangeEvidence"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "content_hash": {
      "anyOf": [
        {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Content Hash"
    },
    "context": {
      "$ref": "#/$defs/Context"
    },
    "diagnosis": {
      "anyOf": [
        {
          "$ref": "#/$defs/DiagnosisEvidence"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "execution": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExecutionEvidence"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "failure": {
      "anyOf": [
        {
          "$ref": "#/$defs/FailureEvidence"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "identity": {
      "$ref": "#/$defs/Identity"
    },
    "observations": {
      "additionalProperties": true,
      "title": "Observations",
      "type": "object"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "recovery": {
      "anyOf": [
        {
          "$ref": "#/$defs/RecoveryEvidence"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "related_evidence_ids": {
      "items": {
        "type": "string"
      },
      "title": "Related Evidence Ids",
      "type": "array"
    },
    "schema_version": {
      "default": "0.1.0",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "title": "Tags",
      "type": "array"
    },
    "validation": {
      "$ref": "#/$defs/ValidationEvidence"
    }
  },
  "required": [
    "identity",
    "provenance",
    "context"
  ],
  "title": "EvidenceRecord",
  "type": "object"
}
